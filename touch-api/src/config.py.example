"""Pydantic 設定.

包含資料庫設定與一個已無作用的 DEBUG 變數。

.. todo::
在 `` 的 refactor branch 中，有一個名為 `app.core.config` 的模組，但它的功能並不相同。在該專案中，資料庫資訊是透過 `/etc/fastapi/shared.env` 與 `os.getenv()` 取得的，而在那個專案中（為了避免混淆我所說的 config.py），`config.py` 是用來取得 `pyproject.toml` 的資訊，並用於建立 `app = FastAPI()` 實例。

**如果你有意重構：**

1. 將所有 `settings.SOME_KEY` 變數改為 `os.getenv('SOME_KEY')`。
2. 新增 `app.core.config` 模組。（我會在 `src.main` 中說明如何處理）
3. 刪除此檔案與 config.py.example，並移除所有相關引用。

*由 林家民 於 2025/7/22 撰寫, 原文為自己寫的英文, 由 ChatGPT 翻譯為繁體中文。*
""" 
from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    """Pydantic settings class, see here for more info: https://fastapi.tiangolo.com/advanced/settings/?h=set#pydantic-settings."""

    DB_HOST: str = ""
    """e.g. '192.x.x.x' (without the quotes)"""
    DB_USERNAME: str = ""
    """Database username."""
    DB_PASSWORD: str = ""
    """Database password. This will have Ruff linting error S105, S105 will be resolved if you follow through with the refactoring tips detailed in this module's todo."""  # noqa: E501
    DB_NAME: str = ""
    """Like, when you connect to DB you should see some top level tables, input the right top level table name."""  # noqa: E501
settings = Settings()
