"""Pydantic settings.

Includes DB settings and a DEBUG value that no longer does anything.

.. todo::
In ``, there is an `app.core.config` that DOES NOT do the same thing. In THAT project, DB info is instead retrieved via `/etc/fastapi/shared.env` and `os.getenv()`, and in THAT project (so you're not confused which config.py I'm talking about), `config.py` is used to retrieve `pyproject.toml` info for the `app = FastAPI()` instantiation.

**If you're interested in refactoring:**

1. Turn any `settings.SOME_KEY` variables into `os.getenv('SOME_KEY')` calls.
2. Add `app.core.config` module. (I will mention how to do that in `src.main`)
3. Delete this file and the config.py.example, and all references to it.
"""  # noqa: E501
from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    """Pydantic settings class, see here for more info: https://fastapi.tiangolo.com/advanced/settings/?h=set#pydantic-settings."""

    DB_HOST: str = ""
    """e.g. '192.x.x.x' (without the quotes)"""
    DB_USERNAME: str = ""
    """Database username."""
    DB_PASSWORD: str = ""
    """Database password. This will have Ruff linting error S105, S105 will be resolved if you follow through with the refactoring tips detailed in this module's todo."""  # noqa: E501
    DB_NAME: str = ""
    """Like, when you connect to DB you should see some top level tables, input the right top level table name."""  # noqa: E501
settings = Settings()
