{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ruff: check + safe fix",
      "type": "shell",
      "command": "uvx",
      "args": [
        "ruff",
        "check",
        "--fix",
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$python"]
    },
	{
      "label": "Generate docs with pdoc",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pdoc",
        "--html",
        "src",
        "--force",
        "-o",
        "wiki"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
