{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fastapi dev",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "cwd": "${workspaceFolder}/src/",
      "args": [
        "dev"
      ],
      "justMyCode": false,
      "env": {
        "ENVIRONMENT": "dev"
      }
    },
    {
      "name": "wiki",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "pdoc",
        "--http",
        ":",
        "src"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}