{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "API:DEV",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "cwd": "${workspaceFolder}/src/",
      "args": [
        "dev"
      ],
      "justMyCode": false,
      "env": {
        "ENVIRONMENT": "dev"
      }
    },    
    {
      "name": "API:PROD",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "cwd": "${workspaceFolder}/src/", 
      "args": [
        "run"
      ],
      "justMyCode": false,
      "env": {
        "ENVIRONMENT": "prod"
      }
    }, 
  ]
}
