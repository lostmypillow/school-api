from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    SMB_HOST: str = "192.168.x.x"
    SMB_FOLDER: str = "/folder_1/folder_2/"
    SMB_USERNAME: str = ""
    SMB_PASSWORD: str = ""
    DB_HOST: str = ""
    DB_USERNAME: str = ""
    DB_PASSWORD: str = ""
    DB_NAME: str = ""


settings = Settings()